# ---------------------------------------------------------------------------
# EVISION AI — Environment configuration
# Copy this file to `.env.local` (local dev) or set the variables in the
# Vercel project settings (production).
#
# NEVER commit a real `.env.local`. Never prefix secrets with NEXT_PUBLIC_
# — that would ship them to the browser bundle.
#
# Telemetry pipeline: ESP32 → Firebase Realtime Database → Website. The
# browser reads Firebase directly for the live dashboard; the server reads it
# for charts and historical views.
# ---------------------------------------------------------------------------

# Firebase Realtime Database root URL. Public and client-safe — the browser
# needs it to subscribe to the live stream, so it must be a NEXT_PUBLIC_ var
# (or left as the default below).
NEXT_PUBLIC_FIREBASE_RTDB_URL="https://evisionai-bca1c-default-rtdb.firebaseio.com"

# Firebase project identifier used for the health probe.
FIREBASE_PROJECT_ID="evisionai-bca1c"

# MongoDB Atlas connection string (server-side only).
MONGODB_URI=""

# Logical database name inside the cluster.
MONGODB_DATABASE="evision"

# Collection names (override only if you renamed them in Atlas).
MONGODB_COLLECTION_DEVICES="devices"
MONGODB_COLLECTION_TELEMETRY="telemetry"
MONGODB_COLLECTION_AI_PREDICTIONS="ai_predictions"
MONGODB_COLLECTION_ALERTS="alerts"
MONGODB_COLLECTION_TRIPS="trips"
MONGODB_COLLECTION_ENERGY_SESSIONS="energy_sessions"
MONGODB_COLLECTION_SYSTEM_EVENTS="system_events"

# Canonical production device identifier (written by the live node).
EVISION_DEVICE_ID="EV-001"

# Hard switch for the synthetic demo fleet. When MONGODB_URI is absent the
# platform automatically serves DEMO telemetry for EV-DEMO-001 instead.
EVISION_DEMO_MODE="auto"          # auto | on | off
EVISION_DEMO_DEVICE_ID="EV-DEMO-001"

# Device liveness thresholds in seconds (ONLINE / DELAYED / OFFLINE).
EVISION_ONLINE_WINDOW_S="10"
EVISION_DELAYED_WINDOW_S="30"

# ---------------------------------------------------------------------------
# Device ingest. The ESP32-S3 sends every telemetry POST with:
#   Authorization: Bearer <DEVICE_API_KEY>
#   X-Device-Id: EV-001
# ---------------------------------------------------------------------------

# Shared secret the firmware presents on every POST. Generate with:
#   openssl rand -hex 32
DEVICE_API_KEY=""
# Legacy alias for DEVICE_API_KEY; still honoured if present. Use only one.
EVISION_INGEST_TOKEN=""

# Per-device ingest rate limit (frames per window).
INGEST_RATE_LIMIT="600"
INGEST_RATE_WINDOW_S="60"

# Hard ceilings that keep a request from exhausting a serverless instance.
INGEST_MAX_BODY_BYTES="262144"
INGEST_MAX_FRAMES="200"

# When "off", unknown device ids are rejected instead of auto-registered.
INGEST_AUTO_REGISTER="on"

# ---------------------------------------------------------------------------
# Dashboard / API hardening
# ---------------------------------------------------------------------------

# Read-route rate limit (requests per window, per IP).
EVISION_API_RATE_LIMIT="240"
EVISION_API_RATE_WINDOW_S="60"

# Operator session secret (required in production). Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Set "on" to require a signed operator session on every dashboard API route.
EVISION_REQUIRE_AUTH="off"
EVISION_OPERATOR_PASSWORD=""